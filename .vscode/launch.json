{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "publisher.VCF_test_transformers",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug Focused Test (FOCUS_TEST=true)",
            "type": "debugpy",
            "request": "launch",
            "module": "publisher.VCF_test_transformers",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "FOCUS_TEST": "true"
            }
        },
        {
            "name": "Debug Genes Transformer Test",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "publisher.VCF_test_transformers.TestGenesTransformer",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug Transcripts Transformer Test",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "publisher.VCF_test_transformers.TestTranscriptsTransformer",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug Variants Transformer Test",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": [
                "publisher.VCF_test_transformers.TestVariantsTransformer",
                "-v"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Debug Current Test File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
